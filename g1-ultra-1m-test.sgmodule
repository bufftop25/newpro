#!name=G1 ACQ - Teste Ultra 1 mês
#!desc=v7.5.0-pt-BR.2: Teste experimental do candidato Ultra de 30 TB por um mês. Não confirma gratuidade. Confira preço e renovação na App Store. Desative outros módulos G1 ACQ antes de ativar este.
#!system=ios

[Rule]
# Regra herdada do módulo principal; pode afetar HTTP/3 de outros aplicativos.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-ultra-1m = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.2/g1-acq.js,argument=ultra_1m
g1-ultra-1m-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.2/g1-sku-report.js,argument=ultra_1m

[MITM]
hostname = %APPEND% one.google.com
