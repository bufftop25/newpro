#!name=G1 SKU Scan
#!desc=v7.5.0-pt-BR.1: Coletor independente legado: registra SKUs sem alterar as respostas. O módulo principal já inclui a coleta; não ative os dois ao mesmo tempo.
#!system=ios

[Rule]
# Bloqueia UDP 443 para favorecer o retorno de HTTP/3 a TCP; afeta outros aplicativos.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.1/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.1/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
