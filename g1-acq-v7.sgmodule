#!name=G1 ACQ
#!desc=v7.5.0-pt-BR.1: G1 ACQ em português: coleta passiva de SKUs, últimas 10 respostas, três mapeamentos de produtos e relatório local com exportação JSON. Não consulta o catálogo completo nem garante ofertas.
#!system=ios

[Rule]
# Bloqueia UDP 443 para favorecer o retorno de HTTP/3 a TCP; afeta outros aplicativos.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.1/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/bufftop25/newpro@v7.5.0-pt-BR.1/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
